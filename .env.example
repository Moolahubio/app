# Moolahub environment reference: names only, never values.
#
# Copy to `.env` (gitignored) or a `.dev/*.env` file with mode 600, and fill in
# locally. Secrets live in Replit Secrets, a GitHub environment or that local
# file, never in git, chat, an issue or a PR. No private key is ever an env var:
# Privy holds user keys and the Gov Safe deploys (docs/privy-account-layer.md §2).
#
# Each package has its own example with the names it reads:
#   artifacts/api-server/.env.example      the API (Privy, chain, email, push)
#   artifacts/moolahub-app/.env.example    the web build (public values only)
#   apps/ios/Config/Env.example.xcconfig   the iOS app (public values only)
# This file lists the names shared across packages, the build and CI names, and
# the names today's testnet code still reads until P2 removes it.

# ---------------------------------------------------------------------------
# Database (secret): Supabase, spec §7
# ---------------------------------------------------------------------------
# App connection: the transaction pooler (port 6543) as the least-privilege
# role from migration 0002, `moolahub_app.<project-ref>`. Copy the host from the
# Supabase Connect dialog; percent-encode the password. NO ?sslmode=/ssl*
# parameters: the app refuses a URL that carries them (they would silently
# override the TLS settings below). Local dev: postgres://localhost/moolahub.
DATABASE_URL=
# TLS: the Supabase CA (prod-ca-2021.crt) as PEM; literal "\n" escapes are fine.
# Set -> verify-full against this CA. Unset -> verify-full against the system
# CAs for a remote host, and no TLS for localhost / 127.0.0.1 / a unix socket.
PG_CA_CERT=
# Pool size per instance (default 5). Lower it (e.g. 3) if you fall back to the
# session pooler.
PG_POOL_MAX=
# Migrations, CI and the purge used by e2e teardown: the session pooler (port
# 5432) as the table owner, `postgres.<project-ref>`. Lives in the protected
# GitHub environment only, NEVER in Replit. `pnpm run db:migrate` /
# scripts/post-merge.sh only migrate when it is set.
# The app role is created NOLOGIN; once per environment an owner runs
#   ALTER ROLE moolahub_app WITH LOGIN PASSWORD '<generated>';
# with the password from the secret store (never a file).
MIGRATIONS_DATABASE_URL=

# ---------------------------------------------------------------------------
# Sentry (optional), spec §8. Unset DSN = SDK never initialised, no traffic.
# ---------------------------------------------------------------------------
# API, read at runtime (Replit Secrets). Public.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
# Web, baked in at build time (the DSN ships in the bundle; it is public):
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=
# Builds only. With SENTRY_AUTH_TOKEN set, the API build uploads source maps
# and adds build-time instrumentation; the web build emits hidden source maps,
# uploads them and deletes them (and fails if any .map is left in dist/public).
# SENTRY_AUTH_TOKEN is secret (CI or the build host only); the rest are public.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_API=
SENTRY_PROJECT_WEB=
SENTRY_RELEASE=
SENTRY_BUILD_INSTRUMENTATION=

# ---------------------------------------------------------------------------
# Contracts (contracts/foundry.toml). The ceremony scripts read their own
# public inputs (Safes, owners, thresholds; contracts/script/BuildBaseBatch.s.sol).
# ---------------------------------------------------------------------------
# Secret: an RPC URL carries the provider's key.
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# Secret: contract verification.
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------------
# Role addresses (public). A person confirms each one before any deploy, and
# none is ever the deployer (replit.md, CLAUDE.md). The deploy gate is
# contracts/script/VerifyBase.s.sol, which refuses an empty DEPLOY_EOAS. The
# API only checks the format at boot: when one is set, it must be an EIP-55
# checksummed address, not zero, not another role's address and not one of
# DEPLOY_EOAS or the server's own signer
# (artifacts/api-server/src/lib/roleAddresses.ts). It cannot tell whether a
# person confirmed the address.
# ---------------------------------------------------------------------------
OWNER_ADDRESS=
GUARDIAN_ADDRESS=
TREASURY_ADDRESS=
# Comma-separated EOAs used during deployment (also read by VerifyBase.s.sol).
DEPLOY_EOAS=

# ---------------------------------------------------------------------------
# Today's testnet API, removed with that code in P2
# (docs/privy-account-layer.md §4). Never set in a Base environment: with
# CHAIN_ID set to a Base chain the API refuses to boot while any of the chain
# and custody names below is set (artifacts/api-server/src/lib/legacyChainEnv.ts).
# ---------------------------------------------------------------------------
# Secret: an RPC URL can carry the provider's key.
CHAIN_RPC_URL=
# Public:
CHAIN_EXPLORER_URL=
MONAD_EXPLORER_URL=
USDC_CONTRACT_ADDRESS=
CIRCLE_FACTORY_ADDRESS=
ACCUMULATION_FACTORY_ADDRESS=
GOAL_VAULT_ADDRESS=
# "true" makes new wallets Privy embedded wallets. Keep it "true" (as .replit
# does) until P2: unset, "Continue with Privy" falls back to a server-held key.
ENABLE_PRIVY_CUSTODY=
# Testnet-only toggles (must stay off on a real-money network):
ENABLE_TEST_FAUCET=
ENABLE_DEPOSIT_SYNC=
INDEXER_INTERVAL_MS=
# Fees in basis points (default 200). FEE_BPS is the older name for CIRCLE_FEE_BPS.
GOAL_FEE_BPS=
CIRCLE_FEE_BPS=
# Currency referral rewards stay off unless "true".
REFERRAL_REWARDS_ENABLED=
# Links in emails and referral sign-up links.
APP_URL=
PUBLIC_APP_URL=
# Replit object storage for avatars and uploads.
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
# Only for artifacts/api-server/scripts/set-fee-sink.mjs ("mainnet" or not).
FEE_RECIPIENT_ADDRESS=
CHAIN_NETWORK=
# Logging and local dev: LOG_LEVEL (default info), LISTEN_HOST (unset: Node's
# default, every interface), DEV_LOG_EMAIL_CODES (dev only, ignored in production).
LOG_LEVEL=
LISTEN_HOST=
DEV_LOG_EMAIL_CODES=
# Left out: tunables with safe defaults in code (SETTLEMENT_MAX_ATTEMPTS,
# GAS_TOPUP_WEI, GAS_MIN_WEI, GAS_TOPUP_DAILY_CAP, SYNC_BLOCK_LOOKBACK,
# INDEXER_BLOCK_LOOKBACK, REFERRAL_CODE_CHANGE_CAP, CIRCLE_GRACE_PERIOD_SECS,
# DEV_AUTH_RATE_LIMIT_MAX, DEV_API_RATE_LIMIT_MAX), the names Replit sets
# itself (REPLIT_DEV_DOMAIN, REPLIT_DOMAINS, PORT) and PLATFORM_PRIVATE_KEY,
# which P2 deletes and which is never added to an example.
# Web build: the network label on the wallet screens (the web package's
# .env.example lists every name the web build reads).
VITE_CHAIN_NAME=
