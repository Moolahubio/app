# Moolahub — environment reference (Monad Testnet migration)
#
# Placeholders only — NEVER commit real secrets. Copy to `.env` (gitignored) and
# fill in. Variable names track docs/monad-migration-plan.md §7 (env matrix).
#
# Network target: Monad Testnet — chainId 10143, native gas token MON (18 dp).
# USDC is Circle native testnet USDC (6 dp). See docs/monad-migration-plan.md.

# ---------------------------------------------------------------------------
# Database (required) — Supabase, spec §7
# ---------------------------------------------------------------------------
# App connection: the transaction pooler (port 6543) as the least-privilege
# role from migration 0002, `moolahub_app.<project-ref>`. Copy the host from the
# Supabase Connect dialog; percent-encode the password. NO ?sslmode=/ssl*
# parameters: the app refuses a URL that carries them (they would silently
# override the TLS settings below). Local dev: postgres://localhost/moolahub.
DATABASE_URL=postgresql://moolahub_app.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:6543/postgres
# TLS: the Supabase CA (prod-ca-2021.crt) as PEM; literal "\n" escapes are fine.
# Set -> verify-full against this CA. Unset -> verify-full against the system
# CAs for a remote host, and no TLS for localhost / 127.0.0.1 / a unix socket.
PG_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Pool size per instance (default 5). Lower it (e.g. 3) if you fall back to the
# session pooler.
PG_POOL_MAX=5
# Migrations, CI and the purge used by e2e teardown: the session pooler (port
# 5432) as the table owner, `postgres.<project-ref>`. Lives in the protected
# GitHub environment only, NEVER in Replit. `pnpm run db:migrate` /
# scripts/post-merge.sh only migrate when it is set.
# The app role is created NOLOGIN; once per environment an owner runs
#   ALTER ROLE moolahub_app WITH LOGIN PASSWORD '<generated>';
# with the password from the secret store (never a file).
MIGRATIONS_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Sentry (optional) — spec §8. Unset DSN = SDK never initialised, no traffic.
# ---------------------------------------------------------------------------
# API, read at runtime (Replit Secrets):
SENTRY_DSN=                           # moolahub-api project DSN
SENTRY_ENVIRONMENT=production         # production | staging (default development)
SENTRY_TRACES_SAMPLE_RATE=0.1         # 0..1, default 0 (errors only)
# Web, baked in at build time (the DSN ships in the bundle; it is public):
VITE_SENTRY_DSN=                      # moolahub-web project DSN
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Builds only. With SENTRY_AUTH_TOKEN set, the API build uploads source maps
# and adds build-time instrumentation; the web build emits hidden source maps,
# uploads them and deletes them (and fails if any .map is left in dist/public).
SENTRY_AUTH_TOKEN=                    # SECRET: org auth token, CI/deploy build only
SENTRY_ORG=your-org-slug
SENTRY_PROJECT_API=moolahub-api
SENTRY_PROJECT_WEB=moolahub-web
SENTRY_RELEASE=                       # optional; else the plugin uses the git commit (token builds only)
SENTRY_BUILD_INSTRUMENTATION=true     # optional kill switch: false disables API build-time instrumentation

# ---------------------------------------------------------------------------
# Contracts — Foundry deploy (contracts/, run on the deploy host)
#   foundry.toml exposes the `monad_testnet` rpc + etherscan profiles.
# ---------------------------------------------------------------------------
# RPC + verifier the foundry.toml profiles interpolate:
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONADSCAN_API_KEY=your-etherscan-v2-multichain-api-key   # Etherscan v2, chain 10143

# Deploy inputs. USDC_ADDRESS / OWNER_ADDRESS / GUARDIAN_ADDRESS are REQUIRED by
# the deploy scripts (fail-closed) — they are NEVER defaulted to the deployer.
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_TESTNET_KEY
USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3          # Circle native testnet USDC (6 dp), verified
OWNER_ADDRESS=0xYOUR_OWNER_MULTISIG
GUARDIAN_ADDRESS=0xYOUR_GUARDIAN
FEE_RECIPIENT_ADDRESS=0xYOUR_FEE_RECIPIENT               # optional; defaults to deployed Treasury
FEE_BPS=200                                              # 2% (cap 5%)
# Set after the core stack deploys (read by DeployAccumulation):
TREASURY_ADDRESS=0xDEPLOYED_TREASURY
REPUTATION_ADDRESS=0xDEPLOYED_REPUTATION

# ---------------------------------------------------------------------------
# Backend chain config (artifacts/api-server)
#   Code reads CHAIN_* first, falling back to the legacy BASE_* aliases
#   (e.g. CHAIN_RPC_URL ?? BASE_RPC_URL) for a clean transition.
# ---------------------------------------------------------------------------
CHAIN_RPC_URL=https://testnet-rpc.monad.xyz             # preferred
CHAIN_EXPLORER_URL=https://testnet.monadvision.com      # Monad Testnet explorer
CHAIN_ID=10143                                           # optional explicit chain id
# Legacy aliases (still read as a fallback; set CHAIN_* above instead):
BASE_RPC_URL=https://testnet-rpc.monad.xyz
BASE_EXPLORER_URL=https://testnet.monadvision.com

# Deployed Monad contract addresses (outputs of the deploy):
USDC_CONTRACT_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
CIRCLE_FACTORY_ADDRESS=0xDEPLOYED_CIRCLE_FACTORY
ACCUMULATION_FACTORY_ADDRESS=0xDEPLOYED_ACCUMULATION_FACTORY
GOAL_VAULT_ADDRESS=0xDEPLOYED_GOAL_VAULT

# Platform signer (pays gas / settles). SAME key works on Monad — fund it with
# MON from https://faucet.monad.xyz. Type-2 txs only (Monad has no blob txs).
PLATFORM_PRIVATE_KEY=0xYOUR_PLATFORM_KEY

# Testnet-only toggles (must stay off on a real-money network):
ENABLE_TEST_FAUCET=false        # only relevant if a MockUSDC faucet is deployed
ENABLE_DEPOSIT_SYNC=false

# Indexer (re-tune against Monad ~400ms blocks + public RPC limits 50/25 rps):
INDEXER_INTERVAL_MS=20000

# ---------------------------------------------------------------------------
# Privy (auth/identity on the backend; embedded/smart wallets on the frontend)
#   Enable Monad Testnet (10143) + register the ERC-4337 paymaster in the Privy
#   dashboard, else the gasless flow breaks. Server code is chain-agnostic.
# ---------------------------------------------------------------------------
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# ---------------------------------------------------------------------------
# Frontend (artifacts/moolahub-app, VITE_* baked at build time)
# ---------------------------------------------------------------------------
VITE_PRIVY_APP_ID=your-privy-app-id
VITE_CHAIN_NAME=Monad Testnet   # replaces VITE_BASE_NETWORK (retired in M3)
