// iOS build settings per environment: names only, never values
// (docs/privy-account-layer.md §2). Copy to Env.Dev.xcconfig,
// Env.Staging.xcconfig or Env.Prod.xcconfig, which are gitignored even though
// every value in them is public. Nothing secret ever goes into the app.
// project.yml wires these files in P6.
//
// In an xcconfig file "//" starts a comment, even inside a value, so write a
// URL as https:/$()/host.

// Public: the Privy app ID for this environment (Privy dashboard, App settings).
PRIVY_APP_ID =
// Public: the Privy iOS app client ID for this bundle ID (App settings, Clients).
PRIVY_APP_CLIENT_ID =
// Public: the API base URL, e.g. https:/$()/app.moolahub.io/api.
API_BASE_URL =
// Public: the passkey relying party as a full origin, https:/$()/app.moolahub.io
// in prod (F5) and https:/$()/staging.moolahub.io in dev and staging.
PASSKEY_RP_ORIGIN =
// Public: the URL scheme Privy's OAuth sign-in returns to.
OAUTH_URL_SCHEME =
