# API environment: names only, never values (docs/privy-account-layer.md §2).
# Secrets go in the deployment's Replit Secrets, or in a gitignored
# .dev/*.env file with mode 600 on a laptop. Shared names (database pool,
# Sentry builds, role addresses) are in the root .env.example.

# --- Privy ---
# Public: the Privy app ID for this environment (Privy dashboard, App settings).
PRIVY_APP_ID=
# Secret: full app secret, worker deployment's Replit Secrets only.
PRIVY_APP_SECRET=
# Secret: read-only app secret for the API deployment's Replit Secrets.
PRIVY_APP_SECRET_READONLY=
# Secret: verifies Privy webhooks at /api/webhooks/privy, worker Replit Secrets.
PRIVY_WEBHOOK_SECRET=
# Public: the Earn vault ID from the Privy dashboard, Replit Secrets or env.
PRIVY_VAULT_ID=

# --- Chain and web ---
# Secret: Base RPC URL (it carries the provider's key), Replit Secrets.
BASE_RPC_URL=
# Public: 8453 on staging and prod, 84532 (Base Sepolia) on dev, env.
CHAIN_ID=
# Public: the origin the apps sign in from, e.g. https://app.moolahub.io, env.
APP_ORIGIN=
# Public: extra allowed CORS origins, comma-separated, env.
ALLOWED_ORIGINS=

# --- Database and keys ---
# Secret: Supabase transaction pooler as moolahub_app, Replit Secrets.
DATABASE_URL=
# Secret: 32-byte hex key for upload tokens, Replit Secrets.
APP_ENCRYPTION_KEY=
# Secret: operator console token (x-operator-token), Replit Secrets.
OPERATOR_TOKEN=

# --- Feature switches (public, env) ---
# Kill switch for sponsored gas. The SPONSOR_* caps are named in P4 (§3.9).
SPONSORSHIP_ENABLED=
# Circles stay off (anything but "true") until the contract audit is signed off.
CIRCLES_ENABLED=

# --- Email and push ---
# Secret: Resend API key, worker Replit Secrets.
RESEND_API_KEY=
# Public: sender, e.g. "Moolahub <noreply@moolahub.io>", env.
EMAIL_FROM=
# Public: APNs key ID and Apple team ID, worker env.
APNS_KEY_ID=
APNS_TEAM_ID=
# Secret: APNs .p8 key contents, worker Replit Secrets.
APNS_KEY=
# Public: the app's bundle ID, e.g. io.moolahub.app, worker env.
APNS_TOPIC=

# --- Observability ---
# Public: Sentry DSN, env.
SENTRY_DSN=
