# Web build environment: names only, never values (docs/privy-account-layer.md §2).
# Every VITE_ value is compiled into the public bundle, so only public values
# get a VITE_ name. scripts/check-no-server-secrets.mjs fails the build check
# if a server secret name appears here, in src/ or in dist/public.

# Public: the Privy app ID for this environment, Replit env or CI.
# vite.config.ts uses it when set, else NEXT_PUBLIC_PRIVY_APP_ID, else PRIVY_APP_ID
# (the names today's Replit environment sets).
VITE_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_APP_ID=
# Public: the Privy app client ID for the web client, Replit env or CI.
VITE_PRIVY_CLIENT_ID=
# Public: the network label and block explorer on today's wallet screens.
VITE_CHAIN_NAME=
VITE_EXPLORER_URL=
# Public: Sentry for the web build (the root .env.example has the build names).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=
